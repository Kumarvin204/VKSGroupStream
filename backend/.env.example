# ============================================
# YouTubeLiveStreamAdda — Environment Variables
# ============================================
# Copy this file to .env and fill in REAL values
# cp .env.example .env

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS — Frontend URL (Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# YouTube RTMP Configuration
# Base URL for YouTube's RTMP ingest (do NOT change this)
YOUTUBE_RTMP_BASE_URL=rtmp://a.rtmp.youtube.com/live2

# FFmpeg binary path (use 'ffmpeg' if it's in your system PATH)
FFMPEG_PATH=ffmpeg

# Google OAuth 2.0 (get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-real-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-real-client-secret

# NextAuth.js
NEXTAUTH_SECRET=generate-a-random-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# YouTube Data API v3 Key (optional — used for server-side API calls)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your-real-youtube-api-key
